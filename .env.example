# Configuración SMTP corporativa para Aconcagua Colombia
# Google Workspace: smtp.gmail.com (puerto 587) + Contraseña de Aplicación
# Zoho Mail: smtp.zoho.com (puerto 587)
# Microsoft 365: smtp.office365.com (puerto 587)
# cPanel / Hosting propio: mail.aconcagua.agency (puerto 465 o 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Límite diario anti-spam para proteger la reputación del correo corporativo
MAX_DAILY_EMAILS=25

# Opcional: Webhook (Make / Zapier / n8n) para avisar en Slack o CRM externo cuando entra un lead
LEAD_WEBHOOK_URL=
